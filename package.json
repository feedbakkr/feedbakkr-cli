{
	"name": "@feedbakkr/cli",
	"version": "0.2.1",
	"description": "CLI tools for Feedbakkr — pull schemas and generate TypeScript types",
	"license": "MIT",
	"type": "module",
	"bin": {
		"feedbakkr": "./dist/index.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"security:audit": "npm audit --audit-level=high",
		"security:audit:moderate": "npm audit --audit-level=moderate",
		"security:osv": "osv-scanner --recursive .",
		"security:scan": "npm run security:audit",
		"security:scan:full": "npm run security:audit:moderate && npm run security:osv",
		"verify:publish": "npm test && npm run typecheck && npm run security:audit && npm run build && npm pack --dry-run",
		"prepublishOnly": "npm run verify:publish"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"feedbakkr",
		"feedback",
		"cli",
		"codegen",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/feedbakkr/feedbakkr-cli"
	},
	"homepage": "https://github.com/feedbakkr/feedbakkr-cli#readme",
	"bugs": {
		"url": "https://github.com/feedbakkr/feedbakkr-cli/issues"
	},
	"dependencies": {
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsup": "^8.0.0",
		"typescript": "~7.0.0",
		"vitest": "^5.0.0"
	}
}
